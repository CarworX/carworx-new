{
  "name": "carworx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "typegen": "pnpm --recursive --workspace-concurrency=1 run typegen",
    "lint": "pnpm run typegen && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "test:rls": "node supabase/tests/run-rls.js",
    "test:integration": "pnpm --filter @carworx/web run test:integration",
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "standardwebhooks": "1.1.1",
    "supabase": "2.122.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
