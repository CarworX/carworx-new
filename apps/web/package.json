{
  "name": "@carworx/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "tokens": "node scripts/tokens/cli.ts",
    "tokens:check": "node scripts/tokens/cli.ts --check",
    "contrast": "node scripts/contrast/cli.ts",
    "audit:browser": "node scripts/browser-audit.ts",
    "typegen": "node scripts/tokens/cli.ts --check && wrangler types && react-router typegen",
    "typecheck": "pnpm run typegen && tsc --build",
    "test": "vitest run",
    "build": "react-router build",
    "preview": "pnpm run build && vite preview"
  },
  "dependencies": {
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.156.1"
  }
}
