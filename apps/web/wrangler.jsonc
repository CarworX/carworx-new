{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carworx-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "CARWORX_ENV": "local" },
  "durable_objects": {
    "bindings": [{ "name": "SEARCH_LIMITER", "class_name": "SearchLimiter" }],
  },
  "migrations": [
    { "tag": "search-limiter-v1", "new_sqlite_classes": ["SearchLimiter"] },
  ],

  "env": {
    "staging": {
      "name": "carworx-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "STAGING_WORKER_VERSION" },
      "vars": { "CARWORX_ENV": "staging", "CARWORX_DEV_PAGES": "1" },
      "durable_objects": {
        "bindings": [
          { "name": "SEARCH_LIMITER", "class_name": "SearchLimiter" },
        ],
      },
      "hyperdrive": [
        {
          "binding": "CATALOGUE_DB",
          "id": "cc5e992d66a44f6aa13bd91479494d97",
        },
        {
          "binding": "FORMS_DB",
          "id": "badab079da38444d8945d1b86db40a3d",
        },
        {
          "binding": "RETENTION_DB",
          "id": "1f71d98c48984e25ba23c8d72365494d",
        },
      ],
      "triggers": { "crons": ["17 1 * * *", "* * * * *"] },
    },
    "production": {
      "name": "carworx-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "CARWORX_ENV": "production" },
      "durable_objects": {
        "bindings": [
          { "name": "SEARCH_LIMITER", "class_name": "SearchLimiter" },
        ],
      },
      "hyperdrive": [
        {
          "binding": "CATALOGUE_DB",
          "id": "OWNER_SETS_PRODUCTION_CATALOGUE_DB_HYPERDRIVE_ID",
        },
        {
          "binding": "FORMS_DB",
          "id": "OWNER_SETS_PRODUCTION_FORMS_DB_HYPERDRIVE_ID",
        },
        {
          "binding": "RETENTION_DB",
          "id": "OWNER_SETS_PRODUCTION_RETENTION_DB_HYPERDRIVE_ID",
        },
      ],
      "triggers": { "crons": ["17 1 * * *"] },
    },
  },
}
