{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carworx-web",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "CARWORX_ENV": "local" },
  "env": {
    "staging": {
      "name": "carworx-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "CARWORX_ENV": "staging", "CARWORX_DEV_PAGES": "1" },
    },
  },
}
