{
  "extends": "../../tsconfig.base.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "react-router.config.ts",
    "integration/**/*.ts",
    "scripts/**/*.ts",
    "app/ui/contrast.ts",
    "app/ui/contrast-pairs.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  }
}
