# CarworX environment variable NAMES only. Never put a value in this file.
#
# Copy to .env (or apps/web/.dev.vars for Wrangler) and fill values locally.
# Both are git-ignored. Synthetic/local values only; production secrets never
# live in a file an agent can read (PLAN §12, §15).
#
# T1 (scaffold) reads no variables. Each later task adds the names it needs:
# T2 local Supabase, T3 auth, K2 environments and secret names.

# --- T3 Auth: local Supabase CLI (root .env, read by `supabase start`) ---------
# Substituted into supabase/config.toml [auth.external.google] via env(...).
# From the owner's Google OAuth client (owner guide 4). The ID isn't secret;
# the secret is: the owner pastes it into their own .env, never into chat.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- T3/T5 Worker settings (apps/web/.dev.vars for local `react-router dev`) ---
# The app's own origin; mutations must carry exactly this Origin.
APP_ORIGIN=
# Local: the API URL and publishable (anon) key from `supabase status`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- K2: mode and private exact-match staging recipient policy (both Workers) ---
# CARWORX_ENV is local | staging | production. Production refuses every
# staging/local name below (runbook §7.2).
CARWORX_ENV=
STAGING_APPROVED_RECIPIENTS_JSON=
# Hook Worker only; never passed to the application deployment workflow.
SEND_EMAIL_HOOK_SECRET=
STAGING_RESEND_API_KEY=
STAGING_AUTH_EMAIL_FROM=
# Disposable local direct-Auth tests only; never hosted configuration.
LOCAL_AUTH_EMAIL_HOOK_URI=
LOCAL_AUTH_EMAIL_HOOK_SECRET=

# --- P2-2 search (Claude 19, D-081). Names only; values are private. ---
# Worker secrets, each >= 32 random characters.
SEARCH_CURSOR_KEY=
SEARCH_LIMITER_SALT=
# Hosted: a Hyperdrive binding CATALOGUE_DB for the scoped catalogue_server
# login (caching disabled), declared in apps/web/wrangler.jsonc for staging and
# production (owner-supplied IDs). No connection string or password belongs here.

# --- P2-3 Mapbox (D-082, D-084). Names only. Keep usage inside the free tier. ---
# One server secret (Worker secret, never sent to the browser) for temporary
# geocoding and the server-fetched Static Images map. No public pk. token.
MAPBOX_SERVER_TOKEN=

# --- P2-5 visitor forms (Claude 22). Names only. ---
# Cloudflare Turnstile (owner guide 12). The sitekey is public (a Worker var);
# the secret is a Worker secret. Local and CI use Cloudflare's published test
# keys; a test secret is refused anywhere but CARWORX_ENV=local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hosted: a Hyperdrive binding FORMS_DB for the scoped forms_server login
# (caching disabled), declared in apps/web/wrangler.jsonc for staging and
# production (owner-supplied IDs). No connection string or password belongs here.
# Public owner-verified monitored support/privacy inbox, shown without JavaScript.
# No default. Missing/invalid value leaves the operational fallback blocked.
SUPPORT_CONTACT_EMAIL=

# --- O5 transactional mail. Names only; staging-only and disabled by default. ---
# MAIL_DB is a scoped Hyperdrive binding for mail_server, caching disabled.
# Store this 32-byte base64url AES-GCM key only as a Worker secret.
MAIL_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_SENDING_DOMAIN=
MAIL_DAILY_LIMIT=
MAIL_ENABLED=
# Set only after actual SPF/DKIM/DMARC verification; the app does not verify DNS.
MAIL_DOMAIN_VERIFIED=
